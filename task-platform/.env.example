# Copy to .env locally; do not commit the real .env.
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-random-secret
APP_ENV=development
COOKIE_SECURE=0
DATABASE_PATH=./platform.db
# Use APP_ENV=production and COOKIE_SECURE=1 only with HTTPS.
