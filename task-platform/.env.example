# Local testing uses SQLite when DATABASE_URL is not set.
APP_ENV=development
COOKIE_SECURE=0
DATABASE_PATH=./platform.db
SECRET_KEY=replace-with-a-64-character-random-secret

# Render: put these values in Environment, never on GitHub.
# APP_ENV=production
# COOKIE_SECURE=1
# DATABASE_URL=postgresql://...  (copy Session Pooler from Supabase Connect)
# SECRET_KEY=<generate unique long secret>
# BOOTSTRAP_ADMIN_USERNAME=<temporary, first deploy only>
# BOOTSTRAP_ADMIN_PASSWORD=<temporary, 16+ characters, first deploy only>
