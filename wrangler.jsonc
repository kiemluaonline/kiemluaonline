{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tram-lua",
  "main": "src/worker.js",
  "keep_vars": true,
  "triggers": { "crons": ["0 2 * * *"] },
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tram-lua-db",
    "database_id": "08726420-2019-4438-ae06-76b43ad8f67a",
    "migrations_dir": "migrations"
  }]
}
